<Template>
  <Scrollable>
    <ObjectName>PadFxScroll</ObjectName>
    <SizePolicy>me,me</SizePolicy>
    <Style>#PadFxScroll { qproperty-widgetResizable: true; border: none; background-color: #101014; } #PadFxPanel { background-color: #101014; qproperty-layoutAlignment: 'AlignTop'; }</Style>
    <Children>
  <WidgetGroup trigger="[SettingsTab],padfx">
    <ObjectName>PadFxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <Label><ObjectName>SettingsRowLabel</ObjectName><Size>0me,36f</Size><Text>Pad FX editor · tap a value to cycle · changes apply on the next press</Text></Label>
      <WidgetGroup>
        <ObjectName>SettingsRow</ObjectName><Layout>horizontal</Layout><Size>0me,76f</Size>
        <Children>
          <Label><ObjectName>SettingsRowLabel</ObjectName><Text>Deck / pad</Text><Size>0me,0me</Size></Label>
          <WidgetGroup><ObjectName>PadFxValue</ObjectName><Layout>horizontal</Layout><Size>160f,44f</Size><Children>
          <PushButton>
            <ObjectName>SettingsSegmentLeft</ObjectName><Size>0me,0me</Size><NumberStates>4</NumberStates>
            <State><Number>0</Number><Text>Deck 1</Text></State><State><Number>1</Number><Text>Deck 2</Text></State>
            <State><Number>2</Number><Text>Deck 3</Text></State><State><Number>3</Number><Text>Deck 4</Text></State>
            <Connection><ConfigKey>[PadFX],deck</ConfigKey><EmitOnDownPress>true</EmitOnDownPress></Connection>
          </PushButton>
          </Children></WidgetGroup>
          <WidgetGroup><ObjectName>PadFxValue</ObjectName><Layout>horizontal</Layout><Size>300f,44f</Size><Children>
          <PushButton>
            <ObjectName>SettingsSegmentRight</ObjectName><Size>0me,0me</Size><NumberStates>16</NumberStates>
            <State><Number>0</Number><Text>Normal · Pad 1</Text></State><State><Number>1</Number><Text>Normal · Pad 2</Text></State>
            <State><Number>2</Number><Text>Normal · Pad 3</Text></State><State><Number>3</Number><Text>Normal · Pad 4</Text></State>
            <State><Number>4</Number><Text>Normal · Pad 5</Text></State><State><Number>5</Number><Text>Normal · Pad 6</Text></State>
            <State><Number>6</Number><Text>Normal · Pad 7</Text></State><State><Number>7</Number><Text>Normal · Pad 8</Text></State>
            <State><Number>8</Number><Text>Shift · Pad 1</Text></State><State><Number>9</Number><Text>Shift · Pad 2</Text></State>
            <State><Number>10</Number><Text>Shift · Pad 3</Text></State><State><Number>11</Number><Text>Shift · Pad 4</Text></State>
            <State><Number>12</Number><Text>Shift · Pad 5</Text></State><State><Number>13</Number><Text>Shift · Pad 6</Text></State>
            <State><Number>14</Number><Text>Shift · Pad 7</Text></State><State><Number>15</Number><Text>Shift · Pad 8</Text></State>
            <Connection><ConfigKey>[PadFX],slot</ConfigKey><EmitOnDownPress>true</EmitOnDownPress></Connection>
          </PushButton>
          </Children></WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>SettingsRow</ObjectName><Layout>horizontal</Layout><Size>0me,76f</Size>
        <Children>
          <Label><ObjectName>SettingsRowLabel</ObjectName><Text>Assignment</Text><Size>0me,0me</Size></Label>
          <WidgetGroup><ObjectName>PadFxValue</ObjectName><Layout>horizontal</Layout><Size>460f,44f</Size><Children>
          <PushButton>
            <ObjectName>SettingsSegmentRight</ObjectName><Size>0me,0me</Size><NumberStates>17</NumberStates>
            <State><Number>0</Number><Text>Roll 1/2</Text></State><State><Number>1</Number><Text>Sweep</Text></State>
            <State><Number>2</Number><Text>Flanger 16</Text></State><State><Number>3</Number><Text>Release Brake 3/4</Text></State>
            <State><Number>4</Number><Text>Echo 1/4</Text></State><State><Number>5</Number><Text>Echo 1/2</Text></State>
            <State><Number>6</Number><Text>Reverb</Text></State><State><Number>7</Number><Text>Release Echo 1/2</Text></State>
            <State><Number>8</Number><Text>Trans 1/2</Text></State><State><Number>9</Number><Text>Crush</Text></State>
            <State><Number>10</Number><Text>Filter LFO 4</Text></State><State><Number>11</Number><Text>Release Backspin 4</Text></State>
            <State><Number>12</Number><Text>MT Delay 1/8 (approx)</Text></State><State><Number>13</Number><Text>Dub Echo (approx)</Text></State>
            <State><Number>14</Number><Text>Space (approx)</Text></State><State><Number>15</Number><Text>Release Echo 1</Text></State>
            <State><Number>16</Number><Text>Off</Text></State>
            <Connection><ConfigKey>[PadFX],effect</ConfigKey><EmitOnDownPress>true</EmitOnDownPress></Connection>
          </PushButton>
          </Children></WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>SettingsRow</ObjectName><Layout>horizontal</Layout><Size>0me,76f</Size>
        <Children>
          <Label><ObjectName>SettingsRowLabel</ObjectName><Text>Echo / delay beats only</Text><Size>0me,0me</Size></Label>
          <WidgetGroup><ObjectName>PadFxValue</ObjectName><Layout>horizontal</Layout><Size>460f,44f</Size><Children>
          <PushButton>
            <ObjectName>SettingsSegmentRight</ObjectName><Size>0me,0me</Size><NumberStates>7</NumberStates>
            <State><Number>0</Number><Text>Assignment default</Text></State><State><Number>1</Number><Text>1/8 beat</Text></State>
            <State><Number>2</Number><Text>1/4 beat</Text></State><State><Number>3</Number><Text>1/2 beat</Text></State>
            <State><Number>4</Number><Text>3/4 beat</Text></State><State><Number>5</Number><Text>1 beat</Text></State>
            <State><Number>6</Number><Text>2 beats</Text></State>
            <Connection><ConfigKey>[PadFX],beat</ConfigKey><EmitOnDownPress>true</EmitOnDownPress></Connection>
          </PushButton>
          </Children></WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>SettingsRow</ObjectName><Layout>horizontal</Layout><Size>0me,76f</Size>
        <Children>
          <Label><ObjectName>SettingsRowLabel</ObjectName><Text>FX strength · transport unchanged</Text><Size>0me,0me</Size></Label>
          <WidgetGroup><ObjectName>PadFxValue</ObjectName><Layout>horizontal</Layout><Size>460f,44f</Size><Children>
          <PushButton>
            <ObjectName>SettingsSegmentRight</ObjectName><Size>0me,0me</Size><NumberStates>5</NumberStates>
            <State><Number>0</Number><Text>0% · pad disabled</Text></State><State><Number>1</Number><Text>25%</Text></State>
            <State><Number>2</Number><Text>50%</Text></State><State><Number>3</Number><Text>75%</Text></State>
            <State><Number>4</Number><Text>100% · native default</Text></State>
            <Connection><ConfigKey>[PadFX],strength</ConfigKey><EmitOnDownPress>true</EmitOnDownPress></Connection>
          </PushButton>
          </Children></WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>SettingsRow</ObjectName><Layout>horizontal</Layout><Size>0me,76f</Size>
        <Children>
          <Label><ObjectName>SettingsRowLabel</ObjectName><Text>Release Echo only</Text><Size>0me,0me</Size></Label>
          <WidgetGroup><ObjectName>PadFxValue</ObjectName><Layout>horizontal</Layout><Size>460f,44f</Size><Children>
          <PushButton>
            <ObjectName>SettingsSegmentRight</ObjectName><Size>0me,0me</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>Momentary · hold to apply</Text></State>
            <State><Number>1</Number><Text>Toggle · press again to release</Text></State>
            <Connection><ConfigKey>[PadFX],hold</ConfigKey><EmitOnDownPress>true</EmitOnDownPress></Connection>
          </PushButton>
          </Children></WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>SettingsRow</ObjectName><Layout>horizontal</Layout><Size>0me,76f</Size>
        <Children>
          <PushButton>
            <ObjectName>SettingsSegmentLeft</ObjectName><Size>0me,44f</Size><NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>Reset selected pad</Text></State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection><ConfigKey>[PadFX],reset_slot</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease></Connection>
          </PushButton>
          <PushButton>
            <ObjectName>SettingsSegmentRight</ObjectName><Size>0me,44f</Size><NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>STOP ALL PAD FX · all decks</Text></State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection><ConfigKey>[PadFX],clear_all</ConfigKey><EmitOnPressAndRelease>true</EmitOnPressAndRelease></Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
      <Label><ObjectName>SettingsRowLabel</ObjectName><Size>0me,36f</Size><Text>FLX6 Pad FX mapping required. Saved in preferences; native DSP, not exact Rekordbox sound.</Text></Label>
      <WidgetGroup><SizePolicy>me,me</SizePolicy></WidgetGroup>
    </Children>
  </WidgetGroup>
    </Children>
  </Scrollable>
</Template>
