<!-- Compact beatgrid controls for one deck in the BiteDJ side panel. -->
<Template>
  <WidgetGroup>
    <ObjectName>GridPanel_DeckBlock</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,116f</Size>
    <Children>
      <Label>
        <ObjectName>GridPanel_DeckLabel_<Variable name="channel"/></ObjectName>
        <Text>Deck <Variable name="channel"/></Text>
        <Size>0me,26f</Size>
        <Alignment>left</Alignment>
      </Label>

      <WidgetGroup>
        <ObjectName>GridPanel_ButtonRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,42f</Size>
        <Children>
          <PushButton>
            <ObjectName>GridPanel_Button</ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>&#9664;</Text></State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],beats_translate_earlier</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>GridPanel_SetButton</ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>Set</Text></State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],beats_translate_curpos</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>GridPanel_Button</ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>&#9654;</Text></State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],beats_translate_later</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>GridPanel_ButtonRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,42f</Size>
        <Children>
          <PushButton>
            <ObjectName>GridPanel_Button</ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>BPM -</Text></State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],beats_adjust_slower</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>GridPanel_Button</ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>BPM +</Text></State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],beats_adjust_faster</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
