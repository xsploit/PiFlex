<!--
  Compact deck rail inspired by https://github.com/timewasternl/Pioneered.
  BiteDJ was originally derived from this visual family, so the adaptation
  stays deliberately simple and preserves more horizontal waveform space than
  the PiFlex default view.
-->
<Template>
  <WidgetGroup>
    <ObjectName>MainViewPioneeredInfo</ObjectName>
    <Layout>vertical</Layout>
    <Size>82f,0me</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>MainViewPioneeredHeader</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,30f</Size>
        <Children>
          <Label>
            <ObjectName>MainViewPioneeredDeck</ObjectName>
            <Text>DECK<Variable name="channel"/></Text>
          </Label>
        </Children>
        <Connection>
          <ConfigKey>[Channel<Variable name="channel"/>],play</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup>

      <Key>
        <ObjectName>MainViewPioneeredKey</ObjectName>
        <Size>0me,42f</Size>
        <DisplayCents>false</DisplayCents>
        <Connection><ConfigKey>[Channel<Variable name="channel"/>],visual_key</ConfigKey></Connection>
      </Key>

      <WidgetGroup>
        <ObjectName>MainViewPioneeredControls</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,34f</Size>
        <Children>
          <Template src="skin:templates/toggle_button.xml">
            <SetVariable name="TooltipId">quantize</SetVariable>
            <SetVariable name="ObjectName">MainViewPioneeredQuantize</SetVariable>
            <SetVariable name="Size">34me,34f</SetVariable>
            <SetVariable name="LeftConnectionControl">[Channel<Variable name="channel"/>],quantize</SetVariable>
          </Template>
          <Template src="skin:templates/toggle_button.xml">
            <SetVariable name="TooltipId">keylock</SetVariable>
            <SetVariable name="ObjectName">MainViewPioneeredKeylock</SetVariable>
            <SetVariable name="Size">34me,34f</SetVariable>
            <SetVariable name="LeftConnectionControl">[Channel<Variable name="channel"/>],keylock</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
