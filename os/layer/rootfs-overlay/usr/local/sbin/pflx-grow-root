#!/bin/sh
set -eu

state_dir=/var/lib/pflx
marker="$state_dir/root-grown"
mkdir -p "$state_dir"

root_source=$(findmnt -nro SOURCE /)
rootdev=$(readlink -f "$root_source")
case "$rootdev" in
    /dev/mmcblk*p*|/dev/sd*[0-9]|/dev/nvme*n*p*) ;;
    *)
        echo "PFLX: root device $root_source resolves to unsupported device $rootdev" >&2
        exit 1
        ;;
esac

parent=$(lsblk -nro PKNAME "$rootdev" | head -n 1)
partnum=$(lsblk -nro PARTN "$rootdev" | head -n 1)
test -n "$parent"
test -n "$partnum"

growpart "/dev/$parent" "$partnum"
resize2fs "$rootdev"
sync
touch "$marker"
