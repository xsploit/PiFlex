#!/bin/sh
set -eu

swapoff -a 2>/dev/null || true

for governor in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$governor" ] || continue
    printf '%s\n' performance > "$governor"
done

# Core 2 is dedicated to the Pi USB host interrupt path. On PREEMPT_RT each
# IRQ has a schedulable thread, so both its affinity and FIFO priority matter.
for action in /proc/irq/*/actions; do
    [ -r "$action" ] || continue
    if grep -Eiq 'xhci|usb|dwc' "$action"; then
        irq=${action#/proc/irq/}
        irq=${irq%/actions}
        [ -w "/proc/irq/$irq/smp_affinity" ] && printf '%s\n' 4 > "/proc/irq/$irq/smp_affinity" || true
        for task in /proc/[0-9]*/task/[0-9]*/comm; do
            [ -r "$task" ] || continue
            name=$(cat "$task")
            case "$name" in
                irq/$irq-*)
                    tid=${task%/comm}
                    tid=${tid##*/}
                    taskset -pc 2 "$tid" >/dev/null 2>&1 || true
                    chrt -f -p 85 "$tid" >/dev/null 2>&1 || true
                    ;;
            esac
        done
    fi
done

echo 'PFLX: performance governor, no swap, and USB IRQ tuning applied'
