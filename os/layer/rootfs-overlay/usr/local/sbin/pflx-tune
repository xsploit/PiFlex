#!/bin/sh
set -eu

swapoff -a 2>/dev/null || true

for governor in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$governor" ] || continue
    printf '%s\n' performance > "$governor"
done

# Core 2 is dedicated to the Pi USB host interrupt path. On PREEMPT_RT each
# IRQ has a schedulable thread, so both its affinity and FIFO priority matter.
for action in /proc/irq/*/actions; do
    [ -r "$action" ] || continue
    if grep -Eiq 'xhci|usb|dwc' "$action"; then
        irq=${action#/proc/irq/}
        irq=${irq%/actions}
        [ -w "/proc/irq/$irq/smp_affinity" ] && printf '%s\n' 4 > "/proc/irq/$irq/smp_affinity" || true
        for task in /proc/[0-9]*/task/[0-9]*/comm; do
            [ -r "$task" ] || continue
            name=$(cat "$task")
            case "$name" in
                irq/$irq-*)
                    tid=${task%/comm}
                    tid=${tid##*/}
                    taskset -pc 2 "$tid" >/dev/null 2>&1 || true
                    chrt -f -p 85 "$tid" >/dev/null 2>&1 || true
                    ;;
            esac
        done
    fi
done

# On Raspberry Pi's PREEMPT_RT kernel the RP1 USB IRQ action files may be
# empty even though the schedulable IRQ threads are named for xHCI. Discover
# those threads directly as a fallback so the RT kernel actually receives the
# CPU and priority layout PiFlex promises.
for task in /proc/[0-9]*/task/[0-9]*/comm; do
    [ -r "$task" ] || continue
    name=$(cat "$task")
    case "$name" in
        irq/[0-9]*-*xhci*|irq/[0-9]*-*usb*|irq/[0-9]*-*dwc*)
            irq=${name#irq/}
            irq=${irq%%-*}
            tid=${task%/comm}
            tid=${tid##*/}
            [ -w "/proc/irq/$irq/smp_affinity" ] && \
                printf '%s\n' 4 > "/proc/irq/$irq/smp_affinity" || true
            taskset -pc 2 "$tid" >/dev/null 2>&1 || true
            chrt -f -p 85 "$tid" >/dev/null 2>&1 || true
            ;;
    esac
done

echo 'PFLX: performance governor, no swap, and USB IRQ tuning applied'
